<?xml version="1.0" encoding="utf-8"?>
<!-- PortGaGotoku: configuration of the launcher process for .NET Framework (pywebview
     loads WinForms and WebView2 through pythonnet in the default domain, which reads
     PortGaGotoku.exe.config). A zip downloaded with a browser carries the Mark of the Web, and
     Windows' extraction copies it to every file: .NET then treats Python.Runtime.dll and the
     WebView2 assemblies as remote and refuses to load them ("Failed to resolve
     Python.Runtime.Loader.Initialize"). loadFromRemoteSources lets it load them as local files. -->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
