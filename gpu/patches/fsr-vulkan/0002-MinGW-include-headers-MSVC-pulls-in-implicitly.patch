From: bbport Windows port
Subject: [PATCH] MinGW: include the headers that MSVC pulls in implicitly

ffx_vk.cpp uses floor/log2 and placement new, ffx_fsr3.cpp and ffx_message.cpp
use swprintf; MinGW's libstdc++ does not include <cmath>, <new> or <wchar.h>
transitively there. No effect on Linux builds.
---
--- a/upstream/ffx-1.1.4/sdk/src/backends/vk/ffx_vk.cpp
+++ b/upstream/ffx-1.1.4/sdk/src/backends/vk/ffx_vk.cpp
@@ -20,6 +20,8 @@
 // OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN
 // THE SOFTWARE.
 
+#include <cmath>  // for floor, log2
+#include <new>    // for placement new
 #include <FidelityFX/host/ffx_interface.h>
 #include <FidelityFX/host/ffx_util.h>
 #include <FidelityFX/host/ffx_assert.h>
--- a/upstream/ffx-1.1.4/sdk/src/components/fsr3/ffx_fsr3.cpp
+++ b/upstream/ffx-1.1.4/sdk/src/components/fsr3/ffx_fsr3.cpp
@@ -20,6 +20,7 @@
 // OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN
 // THE SOFTWARE.
 
+#include <wchar.h>        // for swprintf
 #include <algorithm>    // for max used inside SPD CPU code.
 #include <cmath>        // for fabs, abs, sinf, sqrt, etc.
 #include <string.h>     // for memset
--- a/upstream/ffx-1.1.4/sdk/src/shared/ffx_message.cpp
+++ b/upstream/ffx-1.1.4/sdk/src/shared/ffx_message.cpp
@@ -20,6 +20,7 @@
 // OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN
 // THE SOFTWARE.
 
+#include <wchar.h>  // required for swprintf_s()
 #include <FidelityFX/host/ffx_message.h>
 #include <FidelityFX/host/ffx_util.h>
 
